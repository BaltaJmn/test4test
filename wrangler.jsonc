{
  // Workers Static Assets, not Pages: Cloudflare's own best-practices guide says
  // new projects should use Workers, and that Pages only gets maintenance now.
  "name": "test4test",
  "compatibility_date": "2026-08-31",

  // Explicito a proposito: declarar "routes" lo apaga por defecto y tira abajo
  // la URL *.workers.dev sin avisar mas que con un WARNING.
  "workers_dev": true,

  // Cloudflare crea y gestiona este registro DNS el solo. El apex queda libre.
  // Ojo: quilt.baltajmn.dev es GitHub Pages y va aparte, en DNS only.
  "routes": [{ "pattern": "testers.baltajmn.dev", "custom_domain": true }],

  // The app is Android-only. What is left here is static: the landing page that
  // explains how to join the closed test and opens shared links in the app, and
  // the privacy policy Play links to (/privacy resolves to privacy.html).
  "assets": {
    "directory": "./web"
  }
  // No "main" and no ASSETS binding on purpose: there is no Worker script.
}
