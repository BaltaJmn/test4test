## Copia este archivo a local.properties (gitignored) y rellena tus valores.
## local.properties NO se sube nunca a git.

sdk.dir=/path/to/your/Android/sdk

# Dashboard Supabase -> Settings -> API -> Project URL
supabase.url=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
# Dashboard Supabase -> Settings -> API -> Project API keys -> anon / public
# Seguro compartir/versionar en local: esta protegida por RLS, no es secreta.
supabase.anonKey=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# RevenueCat -> Project settings -> API keys -> Public app key de Android (goog_...)
# Opcional: sin ella la app compila igual, solo que el boton de compra no aparece.
# Publica por diseno, pero no vale para nada sin la cuenta detras.
revenuecat.androidKey=goog_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
